+// Mockingword：GPU の選択・デバイスの取得・検算の結果を、拡張機能が読む1行（"ggml_webgpu: report {JSON}"）で知らせる。
+// 拡張機能は GPU を自分で求めず、この報告だけを表示とログに使う（推論に使う GPU と表示がずれない）。
+struct ggml_webgpu_report {
+    std::vector<std::string> candidates;  // 求めた順の各結果（JSON のオブジェクト）
+    std::string              chosen;      // 使うアダプターを返した powerPreference
+    std::string              device;      // 取得できたデバイスの条件
+    std::string              probe;       // 検算の結果（JSON のオブジェクト）
+    std::string              error;       // GPU を使わない理由
+};
+
+static ggml_webgpu_report & ggml_webgpu_report_state() {
+    static ggml_webgpu_report report;
+    return report;
+}
+
+static std::string ggml_webgpu_json_string(const std::string & s) {
+    std::string out = "\"";
+    for (const unsigned char c : s) {
+        switch (c) {
+            case '"':
+                out += "\\\"";
+                break;
+            case '\\':
+                out += "\\\\";
+                break;
+            case '\n':
+                out += "\\n";
+                break;
+            case '\r':
+                out += "\\r";
+                break;
+            case '\t':
+                out += "\\t";
+                break;
+            default:
+                if (c < 0x20) {
+                    char buf[8];
+                    snprintf(buf, sizeof(buf), "\\u%04x", c);
+                    out += buf;
+                } else {
+                    out += static_cast<char>(c);
+                }
+        }
+    }
+    return out + "\"";
+}
+
+static std::string ggml_webgpu_json_optional(const std::string & s) {
+    return s.empty() ? std::string("null") : ggml_webgpu_json_string(s);
+}
+
+static void ggml_webgpu_emit_report(bool ready) {
+    const auto & r    = ggml_webgpu_report_state();
+    std::string  json = std::string("{\"ready\":") + (ready ? "true" : "false") + ",\"candidates\":[";
+    for (size_t i = 0; i < r.candidates.size(); i++) {
+        json += (i ? "," : "") + r.candidates[i];
+    }
+    json += "],\"chosen\":" + ggml_webgpu_json_optional(r.chosen);
+    json += ",\"device\":" + ggml_webgpu_json_optional(r.device);
+    json += ",\"probe\":" + (r.probe.empty() ? std::string("null") : r.probe);
+    json += ",\"error\":" + ggml_webgpu_json_optional(r.error) + "}";
+    GGML_LOG_INFO("ggml_webgpu: report %s\n", json.c_str());
+}
