+// 答えの分かる小さな計算で GPU を確かめる（sakutto 0007）。workgroup の足し算が合わなければ GPU を使わない。
+// subgroups を使うときは実際の subgroup_size を読み、報告された範囲に無ければ subgroups を切って workgroup の集計を使う。
+static bool ggml_webgpu_correctness_probe(ggml_backend_webgpu_reg_context * ctx) {
+    auto &   caps    = ctx->webgpu_global_ctx->capabilities;
+    auto &   report  = ggml_webgpu_report_state();
+    uint32_t add_sum = 0;
+    if (!ggml_webgpu_run_u32_probe(ctx, ggml_webgpu_probe_add_wgsl(), "correctness_add", &add_sum)) {
+        report.error = "correctness probe could not run";
+        return false;
+    }
+    if (add_sum != GGML_WEBGPU_PROBE_ADD_SUM) {
+        report.error = "correctness probe add " + std::to_string(add_sum) + " != " + std::to_string(GGML_WEBGPU_PROBE_ADD_SUM);
+        return false;
+    }
+
+    uint32_t    subgroup_size = 0;
+    std::string subgroup_note;
+    if (caps.supports_subgroups) {
+        if (!ggml_webgpu_run_u32_probe(ctx, ggml_webgpu_probe_subgroup_wgsl(), "correctness_subgroup", &subgroup_size)) {
+            subgroup_note = "subgroup shader failed";
+            ggml_webgpu_disable_subgroups(caps);
+        } else if (subgroup_size == 0 || subgroup_size < caps.min_subgroup_size ||
+                   subgroup_size > caps.max_subgroup_size) {
+            subgroup_note = "subgroup_size " + std::to_string(subgroup_size) + " not in [" +
+                            std::to_string(caps.min_subgroup_size) + "," + std::to_string(caps.max_subgroup_size) + "]";
+            ggml_webgpu_disable_subgroups(caps);
+        }
+    }
+    report.probe = "{\"add\":" + std::to_string(add_sum) + ",\"subgroups\":" + (caps.supports_subgroups ? "true" : "false") +
+                   ",\"subgroupSize\":" + std::to_string(subgroup_size) +
+                   ",\"note\":" + ggml_webgpu_json_optional(subgroup_note) + "}";
+    return true;
 }
 
