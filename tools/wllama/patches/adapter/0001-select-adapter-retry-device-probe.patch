+static const char * ggml_webgpu_power_preference_name(wgpu::PowerPreference preference) {
+    switch (preference) {
+        case wgpu::PowerPreference::HighPerformance:
+            return "high-performance";
+        case wgpu::PowerPreference::LowPower:
+            return "low-power";
+        default:
+            return "default";
+    }
+}
