+// high-performance・既定・low-power の3通りで求め、この順で shader-f16 を持つ最初のアダプターを使う（無ければ最初のもの）。
+// 単体GPUと内蔵GPUの両方があるPCで、ブラウザーの既定が shader-f16 の無い・遅い GPU を返すことに備える（sakutto 0007、
+// ggml-org/llama.cpp#21744）。Windows の Chrome は powerPreference を採らない（crbug 369219127）ので、3通りとも同じ GPU が返る。
+// ブラウザーが複数の GPU を見せているかを確かめられるよう、使わないものも含めて3通りすべてを report に残す。
 static void ggml_backend_webgpu_request_adapter(wgpu::Instance & instance, wgpu::Adapter & adapter) {
-    wgpu::RequestAdapterOptions options = {};
+    auto & report = ggml_webgpu_report_state();
+    report        = ggml_webgpu_report{};
+
+    const wgpu::PowerPreference preferences[] = {
+        wgpu::PowerPreference::HighPerformance,
+        wgpu::PowerPreference::Undefined,
+        wgpu::PowerPreference::LowPower,
+    };
+    wgpu::Adapter found[3];
+    bool          has_f16[3] = { false, false, false };
+
+    for (size_t i = 0; i < 3; i++) {
+        wgpu::RequestAdapterOptions options = {};
+        options.powerPreference             = preferences[i];
+
+#if !defined(__EMSCRIPTEN__) && !defined(__wasi__)
+        // TODO: track need for these toggles: https://issues.chromium.org/issues/42251215
+        const char * const          adapterEnabledToggles[] = { "vulkan_enable_f16_on_nvidia", "use_vulkan_memory_model" };
+        wgpu::DawnTogglesDescriptor adapterTogglesDesc;
+        adapterTogglesDesc.enabledToggles     = adapterEnabledToggles;
+        adapterTogglesDesc.enabledToggleCount = 2;
+        options.nextInChain                   = &adapterTogglesDesc;
+#endif
+
+        std::string error;
+        instance.WaitAny(
+            instance.RequestAdapter(
+                &options, wgpu::CallbackMode::AllowSpontaneous,
+                [&found, &error, i](wgpu::RequestAdapterStatus status, wgpu::Adapter _adapter, wgpu::StringView message) {
+                    if (status != wgpu::RequestAdapterStatus::Success) {
+                        error = std::string(message);
+                        return;
+                    }
+                    found[i] = std::move(_adapter);
+                }),
+            UINT64_MAX);
+
+        const std::string preference = ggml_webgpu_power_preference_name(preferences[i]);
+        if (found[i] == nullptr) {
+            GGML_LOG_ERROR("ggml_webgpu: Failed to get an adapter (%s): %s\n", preference.c_str(), error.c_str());
+            report.candidates.push_back("{\"preference\":" + ggml_webgpu_json_string(preference) +
+                                        ",\"error\":" + ggml_webgpu_json_string(error) + "}");
+            continue;
+        }
+        wgpu::AdapterInfo info{};
+        found[i].GetInfo(&info);
+        has_f16[i]               = found[i].HasFeature(wgpu::FeatureName::ShaderF16);
+        const bool has_subgroups = found[i].HasFeature(wgpu::FeatureName::Subgroups);
+        report.candidates.push_back(
+            "{\"preference\":" + ggml_webgpu_json_string(preference) +
+            ",\"vendor\":" + ggml_webgpu_json_string(std::string(info.vendor)) +
+            ",\"architecture\":" + ggml_webgpu_json_string(std::string(info.architecture)) +
+            ",\"device\":" + ggml_webgpu_json_string(std::string(info.device)) +
+            ",\"description\":" + ggml_webgpu_json_string(std::string(info.description)) +
+            ",\"vendorId\":" + std::to_string(info.vendorID) + ",\"deviceId\":" + std::to_string(info.deviceID) +
+            ",\"shaderF16\":" + (has_f16[i] ? "true" : "false") + ",\"subgroups\":" + (has_subgroups ? "true" : "false") +
+            ",\"subgroupMinSize\":" + std::to_string(info.subgroupMinSize) +
+            ",\"subgroupMaxSize\":" + std::to_string(info.subgroupMaxSize) + "}");
+    }
+
+    size_t pick = 3;
+    for (size_t i = 0; i < 3 && pick == 3; i++) {
+        if (found[i] != nullptr && has_f16[i]) {
+            pick = i;
+        }
+    }
+    for (size_t i = 0; i < 3 && pick == 3; i++) {
+        if (found[i] != nullptr) {
+            pick = i;
+        }
+    }
+    if (pick < 3) {
+        adapter       = found[pick];
+        report.chosen = ggml_webgpu_power_preference_name(preferences[pick]);
+    }
+}
