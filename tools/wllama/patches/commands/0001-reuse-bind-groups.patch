+        bind_group_cache.clear();
 #ifdef GGML_WEBGPU_GPU_PROFILE
         if (this->profile_timestamp_host_buf) {
             this->profile_timestamp_host_buf.Destroy();
@@ -598,6 +608,12 @@
     std::vector<size_t>          param_offsets;
     result.num_kernels = dispatches.size();
 
+    const uint64_t generation = ctx->global_ctx->buffer_generation.load(std::memory_order_acquire);
+    if (ctx->bind_group_cache_generation != generation) {
+        ctx->bind_group_cache.clear();
+        ctx->bind_group_cache_generation = generation;
+    }
+
     for (size_t i = 0; i < dispatches.size(); i++) {
         const webgpu_dispatch_desc & dispatch     = dispatches[i];
         const size_t                 param_size   = dispatch.params.size() * sizeof(uint32_t);
@@ -608,12 +624,37 @@
         entries.push_back(ggml_webgpu_make_bind_group_entry(params_binding_num, ctx->param_arena.buffer, param_offset,
                                                             ctx->param_arena.slot_size));
 
-        wgpu::BindGroupDescriptor bind_group_desc;
-        bind_group_desc.layout     = dispatch.pipeline.pipeline.GetBindGroupLayout(0);
-        bind_group_desc.entryCount = entries.size();
-        bind_group_desc.entries    = entries.data();
-        bind_group_desc.label      = dispatch.pipeline.name.c_str();
-        bind_groups.push_back(ctx->global_ctx->device.CreateBindGroup(&bind_group_desc));
+        // パディングを含む構造体全体を hash せず、buffer binding の値だけをキーにする。
+        std::string key;
+        key.reserve(sizeof(WGPUComputePipeline) + entries.size() *
+                    (sizeof(uint32_t) + sizeof(WGPUBuffer) + 2 * sizeof(uint64_t)));
+        const WGPUComputePipeline pipeline_handle = dispatch.pipeline.pipeline.Get();
+        key.append(reinterpret_cast<const char *>(&pipeline_handle), sizeof(pipeline_handle));
+        for (const wgpu::BindGroupEntry & entry : entries) {
+            const WGPUBuffer buffer_handle = entry.buffer.Get();
+            const uint64_t offset = entry.offset;
+            const uint64_t size   = entry.size;
+            key.append(reinterpret_cast<const char *>(&entry.binding), sizeof(entry.binding));
+            key.append(reinterpret_cast<const char *>(&buffer_handle), sizeof(buffer_handle));
+            key.append(reinterpret_cast<const char *>(&offset), sizeof(offset));
+            key.append(reinterpret_cast<const char *>(&size), sizeof(size));
+        }
+
+        auto & cache = ctx->bind_group_cache;
+        auto cached  = cache.find(key);
+        if (cached == cache.end()) {
+            // 可変長 KV や異なる graph での増加を、backend あたり4096件に制限する。
+            if (cache.size() >= 4096) {
+                cache.clear();
+            }
+            wgpu::BindGroupDescriptor bind_group_desc;
+            bind_group_desc.layout     = dispatch.pipeline.pipeline.GetBindGroupLayout(0);
+            bind_group_desc.entryCount = entries.size();
+            bind_group_desc.entries    = entries.data();
+            bind_group_desc.label      = dispatch.pipeline.name.c_str();
+            cached = cache.emplace(std::move(key), ctx->global_ctx->device.CreateBindGroup(&bind_group_desc)).first;
+        }
+        bind_groups.push_back(cached->second);
         param_offsets.push_back(param_offset);
     }
 
