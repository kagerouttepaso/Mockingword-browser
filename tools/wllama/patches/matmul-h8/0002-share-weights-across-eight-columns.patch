@@ -1858,13 +1859,16 @@ static webgpu_encoded_op ggml_webgpu_mul_mat(webgpu_context & ctx,
     if (!use_mat_vec && use_mmvq) {
         std::vector<webgpu_dispatch_desc> dispatches;
         ggml_webgpu_quantize_q8_dispatch(ctx, src0, src1, dst, dispatches);
-        const uint32_t batches = (uint32_t) dst->ne[1] / GGML_WEBGPU_MUL_MAT_VEC_MAX_ROWS;
