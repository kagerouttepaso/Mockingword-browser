-                                        batches, 0, dispatches);
+        // K量子化の8列を同じworkgroupで積み、4列ごとの重みの再読込みを省く。
+        const uint32_t max_columns = (src0->type == GGML_TYPE_Q4_K || src0->type == GGML_TYPE_Q6_K) ?
+                                         8u : GGML_WEBGPU_MUL_MAT_VEC_MAX_ROWS;
+        const uint32_t columns = std::min<uint32_t>((uint32_t) dst->ne[1], max_columns);
+        const uint32_t batches = (uint32_t) dst->ne[1] / columns;
+        const uint32_t rest    = (uint32_t) dst->ne[1] % columns;
+        ggml_webgpu_append_mmvq_columns(ctx, shader_lib_ctx, src0, src1, dst, columns, batches, 0, dispatches);
         if (rest > 0) {
             ggml_webgpu_append_mmvq_columns(ctx, shader_lib_ctx, src0, src1, dst, rest, 1,
