+// chain の最後に置く出力制御。選択順序・候補・確率の計算には介入しない。
+static const char * token_only_name(const llama_sampler *) { return "token-only-output"; }
+static void token_only_apply(llama_sampler *, llama_token_data_array *) {}
+static bool token_only_backend_init(llama_sampler *, ggml_backend_buffer_type_t, uint32_t) { return true; }
+static void token_only_backend_apply(llama_sampler *, ggml_context *, ggml_cgraph *, llama_sampler_data * data) {
+    // 未対応 sampler がある場合は chain がここへ到達せず、従来の CPU fallback が働く。
+    if (data->sampled) {
+        data->logits = nullptr;
+        data->probs = nullptr;
+        data->candidates = nullptr;
+    }
+}
+static llama_sampler * token_only_init();
+static llama_sampler * token_only_clone(const llama_sampler *) { return token_only_init(); }
+static llama_sampler * token_only_init() {
+    static llama_sampler_i iface = {
+        /* .name              = */ token_only_name,
+        /* .accept            = */ nullptr,
+        /* .apply             = */ token_only_apply,
+        /* .reset             = */ nullptr,
+        /* .clone             = */ token_only_clone,
+        /* .free              = */ nullptr,
+        /* .backend_init      = */ token_only_backend_init,
+        /* .backend_accept    = */ nullptr,
+        /* .backend_apply     = */ token_only_backend_apply,
+        /* .backend_set_input = */ nullptr,
+        /* .backend_reset     = */ nullptr,
+        /* .copy_state        = */ nullptr,
+    };
+    return llama_sampler_init(&iface, nullptr);
+}
+
+static bool token_only_eligible(const common_params_sampling & p) {
+    if (!p.backend_sampling_token_only || !p.backend_sampling || p.n_probs != 0 ||
+        p.temp != 0.0f || p.dynatemp_range != 0.0f || p.mirostat != 0 ||
+        !p.grammar.empty() || p.grammar_lazy || !p.grammar_triggers.empty() ||
+        !p.preserved_tokens.empty() || !p.logit_bias.empty() ||
+        p.ignore_eos || p.penalty_repeat != 1.0f || p.penalty_freq != 0.0f || p.penalty_present != 0.0f ||
+        p.dry_multiplier != 0.0f || p.xtc_probability != 0.0f || p.typ_p != 1.0f ||
+        p.adaptive_target >= 0.0f || p.top_n_sigma > 0.0f || p.reasoning_budget_tokens >= 0 ||
+        p.reasoning_control || p.samplers.empty() || p.samplers.back() != COMMON_SAMPLER_TYPE_TEMPERATURE) {
+        return false;
+    }
+    for (const auto sampler : p.samplers) {
+        switch (sampler) {
+            case COMMON_SAMPLER_TYPE_PENALTIES:
+            case COMMON_SAMPLER_TYPE_DRY:
+            case COMMON_SAMPLER_TYPE_TOP_N_SIGMA:
+            case COMMON_SAMPLER_TYPE_TOP_K:
+            case COMMON_SAMPLER_TYPE_TYPICAL_P:
+            case COMMON_SAMPLER_TYPE_TOP_P:
+            case COMMON_SAMPLER_TYPE_MIN_P:
+            case COMMON_SAMPLER_TYPE_XTC:
+            case COMMON_SAMPLER_TYPE_TEMPERATURE:
+                break;
+            default:
+                return false;
+        }
+    }
+    return true;
+}
