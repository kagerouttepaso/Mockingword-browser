+// token-only の全行が同じ backend にある場合だけ、既存 API で一括取得する。
+// get_n 自体は完了を待たないため、個別の get_async と同じ完了保証を先に満たす。
+static bool copy_token_only_rows(const llm_graph_result * res, const buffer_view<llama_token> & dst,
+        uint32_t row_offset, ggml_backend_sched_t sched) {
+    const size_t n = res->t_sampled.size();
+    if (n == 0 || !dst.has_data()) {
+        return false;
+    }
+    std::vector<const ggml_tensor *> tensors;
+    std::vector<size_t> offsets(n, 0), sizes(n, sizeof(llama_token)), data_offsets(n);
+    tensors.reserve(n);
+    ggml_backend_t backend = nullptr;
+    for (size_t i = 0; i < n; ++i) {
+        auto * t = res->t_sampled[i];
+        if (!t || res->t_sampled_logits[i] || res->t_sampled_probs[i] || res->t_candidates[i]) {
+            return false;
+        }
+        GGML_ASSERT(t->type == GGML_TYPE_I32 && ggml_is_contiguous(t) && ggml_nelements(t) == 1);
+        auto * current_backend = ggml_backend_sched_get_tensor_backend(sched, t);
+        GGML_ASSERT(current_backend);
+        if (backend && backend != current_backend) {
+            return false;
+        }
+        backend = current_backend;
+        tensors.push_back(t);
+        data_offsets[i] = i * sizeof(llama_token);
+    }
+    GGML_ASSERT(row_offset + n <= dst.size);
+    ggml_backend_synchronize(backend);
+    ggml_backend_tensor_get_n(tensors.data(), dst.data + row_offset,
+        offsets.data(), sizes.data(), data_offsets.data(), n);
+    return true;
+}
